# Copy to .env.local for local development. Once the project is linked to Vercel,
# `vercel env pull .env.local` keeps these in sync with the Development scope
# instead of maintaining them by hand.
#
# Every value below is set separately for Production and for Preview/Development
# in the Vercel dashboard. Nothing is shared between the two.

# --- MongoDB ---------------------------------------------------------------
# One Atlas cluster, two databases. The database name at the end of the URI is
# the only thing separating environments, so it is never the same in both:
#   production            -> test  (where the existing data already lives)
#   preview + development -> weeklyplate_dev
# The name is required: without it MongoDB silently falls back to "test", which
# is how both environments ended up sharing one database in the first place.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/weeklyplate_dev?retryWrites=true&w=majority"

# The database this environment is allowed to use. Setting it turns on the check
# that refuses to boot when MONGODB_URI disagrees, which is what catches a
# production connection string pasted into a development scope. Set it in every
# Vercel environment.
MONGODB_DB_EXPECTED="weeklyplate_dev"

# --- Clerk -----------------------------------------------------------------
# Separate instances: pk_test/sk_test for dev, pk_live/sk_live for production.
# Both instances need the `metadata` session-token claim and their own `creator`
# role grants — neither carries over. See the README.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/planner"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/planner"

# --- Public contact --------------------------------------------------------
# Shown on /privacy and in the Play Store listing.
NEXT_PUBLIC_SUPPORT_EMAIL="privacy@theweeklyplate.app"

# --- Vercel Blob — OPTIONAL ------------------------------------------------
# If unset, the meal form falls back to pasting an image URL. Create two stores
# and connect each to its own environments so uploads never mix; the token then
# differs per scope rather than being injected everywhere.
BLOB_READ_WRITE_TOKEN=""

# --- Meal autofill — OPTIONAL ----------------------------------------------
# Unsplash (https://unsplash.com/developers) — suggests a photo for the meal
# title. Register a second app for dev and leave it as a Demo app; the ~50/hour
# limit is a useful ceiling on accidental development usage.
UNSPLASH_ACCESS_KEY=""

# Spoonacular (https://spoonacular.com/food-api) — suggests ingredients,
# instructions, cuisine and veg/non-veg. The free tier is one key per account,
# so either use a second account or leave this unset in dev: diet and cuisine
# still fall back to a keyword heuristic.
SPOONACULAR_API_KEY=""

# --- YouTube recipe import — OPTIONAL --------------------------------------
# Google Gemini (https://aistudio.google.com/apikey) — transcribes the video and
# extracts the recipe. Create the dev key in a SEPARATE Google Cloud project;
# a second key in the same project shares the same quota, and import testing is
# the most quota-hungry thing you do.
GOOGLE_GENERATIVE_AI_API_KEY=""
